# callsense — environment configuration
#
# Copy to .env and fill in the REQUIRED values:
#     cp .env.example .env
#
# .env is gitignored and must never be committed. Only the provider matching
# LLM_PROVIDER needs a key — the other two can stay as placeholders.

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════════════════════

# Which LLM backend the provider factory instantiates. Switching this is the
# only change needed to move between providers — no code edits.
# Values: openai | gemini | groq
LLM_PROVIDER=openai

# --- OpenAI (paid; ~$0.03/call with gpt-4o) -------------------------------
# Key from https://platform.openai.com/api-keys (program-issued for this course).
OPENAI_API_KEY=your-openai-api-key
# Values: gpt-4o (spec default, best structured-output quality) | gpt-4o-mini (cheaper, lower fidelity)
OPENAI_MODEL=gpt-4o

# --- Google Gemini (free tier) --------------------------------------------
# Key from https://aistudio.google.com/apikey
# NOTE: gemini-2.0-flash (named in the course spec, April 2026) no longer carries
# a free-tier token allowance and returns 429 RESOURCE_EXHAUSTED. Verified working
# on the free tier: gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite,
# gemini-3.6-flash. Prefer a pinned name over a *-latest alias, which can shift
# under you mid-project and change QA scores with no visible cause.
GOOGLE_API_KEY=your-google-aistudio-api-key
GEMINI_MODEL=gemini-3.5-flash

# --- Groq (free tier, 30 req/min) -----------------------------------------
# Key from https://console.groq.com/keys — shown only once at creation.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM call behaviour ----------------------------------------------------
# Per-call timeout. Raise to 120 if you see timeouts on long transcripts.
# Values: positive float, seconds
LLM_TIMEOUT_SECONDS=60.0

# Retry attempts per pipeline node before the node fails. Backoff is
# min(2**attempt, 10) seconds, so 3 attempts waits 1s, 2s, 4s.
# Values: positive integer
MAX_RETRIES_PER_NODE=3

# --- Transcription ---------------------------------------------------------
# faster-whisper checkpoint. Use tiny for development: 39 MB, ~1 min per 5-minute
# call on CPU. large-v3 takes 25+ min/call on CPU and is GPU-only in practice.
# Values: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=tiny

# --- Database --------------------------------------------------------------
# SQLite file holding call_records, audit_log, and transcription_cache.
# Created on first run. Gitignored. Use /tmp/calls.db inside a container.
# Values: filesystem path
DB_PATH=data/calls.db

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════════════════════════════════════

# --- Transcript confidence gating ------------------------------------------
# Per-segment confidence is computed as:
#     logprob_conf = max(0, min(1, 1 + avg_logprob))
#     speech_conf  = 1 - no_speech_prob
#     confidence   = logprob_conf * 0.7 + speech_conf * 0.3
#
# Segments scoring below CONFIDENCE_THRESHOLD are marked [LOW CONF] in the UI
# transcript. If the fraction of low-confidence segments exceeds
# LOW_CONFIDENCE_HALT_RATIO, the whole transcript is flagged as unreliable.
# Values: float 0.0–1.0 each
CONFIDENCE_THRESHOLD=0.6
LOW_CONFIDENCE_HALT_RATIO=0.5

# --- Database encryption ---------------------------------------------------
# Applied as a PRAGMA key at connection time. Leave blank to store unencrypted;
# a non-empty value requires a SQLCipher-enabled SQLite build.
# Values: blank (disabled) | passphrase string
DB_ENCRYPTION_KEY=

# --- LangSmith tracing -----------------------------------------------------
# Optional. With tracing off the pipeline runs normally and the Observability
# tab reports LangSmith as disabled.
# NOTE: the course docs use the LANGCHAIN_* prefix; this project standardises on
# LANGSMITH_*. Both are honoured by current langsmith releases — do not mix them.
# Values: true | false
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=callsense
